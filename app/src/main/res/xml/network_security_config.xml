<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Prepare-mode HTTPS only; Explore/Home must not open the network. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
